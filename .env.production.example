# ApexOS Production Environment Variables
# Cloudflare Pages Deployment
# Copy this file to .env.local for local development
# For production, set these in Cloudflare Pages Dashboard:
# Pages → Project → Settings → Environment Variables

# ============================================
# AUTHENTICATION (Required)
# ============================================
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: Better Auth encryption key (generate: openssl rand -base64 32)
BETTER_AUTH_ENCRYPTION_KEY=

# ============================================
# APPLICATION (Required)
# ============================================
# Production URL (after deployment)
NEXT_PUBLIC_APP_URL=https://your-app.pages.dev

# Site URL for SEO/canonical links
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ============================================
# SENTRY ERROR TRACKING (Required for monitoring)
# ============================================
# Get DSN from Sentry project settings
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=apex-os
SENTRY_ENVIRONMENT=production

# Optional: Set to false to disable Sentry in local dev (default: true for production)
NEXT_PUBLIC_SENTRY_ENABLED=true

# ============================================
# CLOUDFLARE (Auto-configured in production)
# ============================================
# These are set automatically by Cloudflare Pages bindings:
# - D1_DATABASE
# - KV namespace
# - R2 bucket

# Cloudflare API credentials for Pages Analytics (Admin dashboard)
# Get API token from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Account.Cloudflare Pages Read, Account.Analytics Read
CLOUDFLARE_API_TOKEN=your_cf_api_token
CLOUDFLARE_ACCOUNT_ID=your_account_id

# D1 Database binding (auto-configured in production, set manually for local dev)
# Find in: Cloudflare Dashboard → Workers & Pages → D1 → your database
D1_DATABASE=apex-os-db

# ============================================
# EMAIL (Resend - Required for signup emails)
# ============================================
RESEND_API_KEY=re_your_resend_key
NEXT_PUBLIC_SENDER_EMAIL=noreply@yourdomain.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# ============================================
# STELLAR PAYOUTS (Required for affiliate commissions)
# ============================================
#
# Getting Started:
# 1. Create a Stellar wallet (xPortal recommended: https://xportal.app)
# 2. Buy USDC and send to your wallet's Account ID (starts with G...)
# 3. Get your Secret Key (starts with S...) from wallet
# 4. Set STELLAR_SECRET_KEY below
# 5. Set network to 'mainnet' for production
#
# Documentation: See docs/stellar-setup.md

# Stellar Secret Key (required for sending payouts)
# WARNING: This is a private key. Keep it secure. Never commit to git.
# Format: Starts with 'S' followed by 56+ characters
STELLAR_SECRET_KEY=S...

# Network: 'testnet' for development, 'mainnet' for production
STELLAR_NETWORK=mainnet

# Automatic cron payout settlement gate:
# Set to 'false' for initial manual-first verification via POST /api/payouts,
# then enable ('true') after the first production payout cycle is verified.
AUTO_SETTLE_PAYOUTS=false

# USDC Issuer address (automatically set based on network)
# Testnet: GA6D2QCM3WQM3YQKV6W5HR5TMRIE5X5QJQZ6WESBG7N5VWBNX6QJX3BM
# Mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGZX3UPOJ2FJ3FNB6DK6L3
# Leave empty to use default for selected network
STELLAR_USDC_ISSUER=

# USDC asset code (default: USDC)
STELLAR_USDC_CODE=USDC

# Optional: Custom Horizon server URL
# Default for testnet: https://horizon-testnet.stellar.org
# Default for mainnet: https://horizon.stellar.org
# STELLAR_HORIZON_URL=https://horizon.stellar.org

# ============================================
# EXCHANGE WEBHOOKS (Required for trade tracking)
# ============================================
BINANCE_WEBHOOK_SECRET=your-binance-webhook-secret
BYBIT_WEBHOOK_SECRET=your-bybit-webhook-secret

# ============================================
# PAYMENTS (Optional - for premium features)
# ============================================
# Polar (international subscriptions)
POLAR_ACCESS_TOKEN=your-polar-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
POLAR_ORGANIZATION_ID=org_your_id

# SePay (Vietnam QR payments)
SEPAY_MERCHANT_ID=your-sepay-merchant-id
SEPAY_SECRET_KEY=your-sepay-secret-key
SEPAY_API_URL=https://api.sepay.vn

# ============================================
# AI SERVICES (Optional)
# ============================================
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ============================================
# ADMIN (For initial admin user)
# ============================================
# Run: openssl rand -base64 32
ADMIN_API_TOKEN=your-admin-token-for-payouts

# ============================================
# NOTIFICATIONS (Multi-channel alerts)
# ============================================
# Enable/disable notifications globally (default: true)
NOTIFICATIONS_ENABLED=true

# Default notification priority: low, normal, high, critical
NOTIFICATION_DEFAULT_PRIORITY=normal

# Rate limiting: max notifications per minute
NOTIFICATION_RATE_LIMIT=60

# Retry configuration
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF=1000

# Support email for notifications
SUPPORT_EMAIL=support@yourdomain.com

# Documentation URL for notification links
DOCS_URL=https://docs.apexos.io

# --------------------------------------------
# Slack Webhook (Optional)
# --------------------------------------------
# Create incoming webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_ENABLED=true
SLACK_CHANNEL=#alerts
SLACK_USERNAME=ApexOS Bot
SLACK_ICON_EMOJI=:rocket:
# Optional: SLACK_ICON_URL=https://your-icon-url.com/icon.png

# --------------------------------------------
# Email (Resend) - Already configured above
# --------------------------------------------
# Email notifications use the Resend configuration above
# Additional recipients for system alerts:
NOTIFICATION_EMAIL_RECIPIENTS=admin@yourdomain.com,alerts@yourdomain.com

# Reply-to address for notifications
RESEND_REPLY_TO=support@yourdomain.com

# --------------------------------------------
# Telegram Bot (Optional)
# --------------------------------------------
# Create bot via @BotFather and get chat ID: https://t.me/BotFather
# Then add bot to chat and get chat ID via @getidsbot or API
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_IDS=-1001234567890
TELEGRAM_ENABLED=true
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=false
