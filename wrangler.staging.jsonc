{
	// NOTE: D1 database_id is required by Wrangler CLI — not a secret.
	// Staging Worker: binds DB strictly to apex-os-staging-db (be4ed659-c877-4820-ae6e-9747bc7ee316).
	// Must NEVER bind or reference the production D1 database, production KV, or production R2.
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker-wrapper.js",
	"name": "apex-os-staging",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"placement": {
		"mode": "smart"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apex-os-staging-db",
			"database_id": "be4ed659-c877-4820-ae6e-9747bc7ee316"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "f2cf595dec5543dc96f6370bebbc8754"
		}
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "apex-os-uploads-staging"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "PAPER_TRADING_DO",
				"class_name": "PaperTradingDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-paper-trading-do",
			"new_classes": ["PaperTradingDurableObject"]
		}
	],
	"vars": {
		"APP_ENV": "staging",
		"NEXT_PUBLIC_APP_URL": "https://apex-os-staging.agencyos-openclaw.workers.dev",
		"WEBAUTHN_RP_ID": "apex-os-staging.agencyos-openclaw.workers.dev",
		"WEBAUTHN_ORIGIN": "https://apex-os-staging.agencyos-openclaw.workers.dev",
		"STELLAR_NETWORK": "testnet",
		"AUTO_SETTLE_PAYOUTS": "false",
		"V1_STELLAR_ONLY_PAYOUTS": "true"
	},
	"triggers": {
		"crons": ["0 0 * * SUN", "0 2 * * *", "*/30 * * * *", "*/5 * * * *", "15 * * * *"]
	}
}
