{
  "name": "apex-os",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:worker": "NEXT_PUBLIC_COMMIT_SHA=${NEXT_PUBLIC_COMMIT_SHA:-$(git rev-parse HEAD)} NEXT_PUBLIC_BUILD_TIME=${NEXT_PUBLIC_BUILD_TIME:-$(date -u +%Y-%m-%dT%H:%M:%SZ)} opennextjs-cloudflare build",
    "deploy:staging": "bash scripts/assert-staging-isolation.sh && npm run build:worker && wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "bash scripts/assert-staging-isolation.sh && npm run build:worker && wrangler deploy --config wrangler.jsonc",
    "verify:deploy": "bash scripts/verify-deployment.sh",
    "reconcile:payouts": "bash scripts/reconcile-historical-payouts.sh",
    "gate": "bash scripts/go-live-gate.sh",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "verify-node": "node scripts/verify-node-version.cjs",
    "typecheck": "rm -rf .next/types .next/dev/types && tsc --noEmit",
    "test": "npm run verify-node && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:alerting": "tsx scripts/test-alerting-system.ts",
    "test:channel": "tsx scripts/test-notification-channel.ts",
    "seed": "tsx scripts/seed-db.ts",
    "rate-limit:init": "tsx scripts/rate-limit-manager.ts init",
    "rate-limit:cleanup": "tsx scripts/rate-limit-manager.ts cleanup",
    "rate-limit:stats": "tsx scripts/rate-limit-manager.ts stats",
    "rate-limit:reset": "tsx scripts/rate-limit-manager.ts reset"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.44.1",
    "@simplewebauthn/server": "^14.1.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "@turnkey/sdk-server": "^8.9.1",
    "better-auth": "^1.7.23",
    "decimal.js": "^10.6.0",
    "json-rules-engine": "^7.3.1",
    "lucide-react": "^0.441.0",
    "mixpanel-browser": "^2.80.0",
    "next": "16.4.3",
    "next-intl": "^4.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "viem": "^2.57.19",
    "web-vitals": "^5.3.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@sentry/nextjs": "^10.59.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "autoprefixer": "^10.4.0",
    "better-sqlite3": "^12.11.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^13.4.0",
    "postcss": "^8.4.0",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0",
    "webpack": "^5.112.2",
    "wrangler": "4.152.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx",
      "**/?(*.)+(test|spec).ts",
      "**/?(*.)+(test|spec).tsx"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json",
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!next-intl|@next)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "overrides": {
    "follow-redirects": "^1.16.3",
    "source-map-js": "^1.2.2",
    "kysely": "^0.29.9",
    "zod": "^4.6.7"
  }
}
