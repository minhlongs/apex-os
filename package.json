{
  "name": "apex-os",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "deploy:staging": "bash scripts/assert-staging-isolation.sh && npm run build:worker && opennextjs-cloudflare deploy --config wrangler.staging.jsonc",
    "deploy:production": "bash scripts/assert-staging-isolation.sh && npm run build:worker && opennextjs-cloudflare deploy --config wrangler.jsonc",
    "verify:deploy": "bash scripts/verify-deployment.sh",
    "reconcile:payouts": "bash scripts/reconcile-historical-payouts.sh",
    "gate": "bash scripts/go-live-gate.sh",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "verify-node": "node scripts/verify-node-version.cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run verify-node && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:alerting": "tsx scripts/test-alerting-system.ts",
    "test:channel": "tsx scripts/test-notification-channel.ts",
    "seed": "tsx scripts/seed-db.ts",
    "rate-limit:init": "tsx scripts/rate-limit-manager.ts init",
    "rate-limit:cleanup": "tsx scripts/rate-limit-manager.ts cleanup",
    "rate-limit:stats": "tsx scripts/rate-limit-manager.ts stats",
    "rate-limit:reset": "tsx scripts/rate-limit-manager.ts reset"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.44.1",
    "better-auth": "0.8.7-beta.5",
    "lucide-react": "^0.441.0",
    "mixpanel-browser": "^2.80.0",
    "next": "16.4.3",
    "next-intl": "^4.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "stellar-sdk": "^12.3.0",
    "web-vitals": "^5.3.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@sentry/nextjs": "^10.59.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "autoprefixer": "^10.4.0",
    "better-sqlite3": "^12.11.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^13.4.0",
    "postcss": "^8.4.0",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0",
    "wrangler": "4.152.0",
    "webpack": "^5.112.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx",
      "**/?(*.)+(test|spec).ts",
      "**/?(*.)+(test|spec).tsx"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json",
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!next-intl|@next)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
