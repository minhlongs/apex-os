# ============================================
# APEXOS STAGING ENVIRONMENT CONFIGURATION
# ============================================
# Mục đích: Staging/Development environment với test/mock credentials
# Lưu ý: Không bao giờ commit file .env.staging vào git
# Sao chép: cp .env.staging.example .env.staging

# ============================================
# 📋 PHẦN 1: AUTHENTICATION & APPLICATION
# ============================================
# These are required for local development

# MOCK - Tạo với: openssl rand -base64 32
BETTER_AUTH_SECRET=mock_better_auth_secret_32_chars_here

# MOCK - Optional encryption key
BETTER_AUTH_ENCRYPTION_KEY=mock_encryption_key_32_chars_here

# STAGING URL - Thay đổi theo nhu cầu
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# 📋 PHẦN 2: MONITORING & ERROR TRACKING
# ============================================

# MOCK - Sentry DSN (development only)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=apex-os
SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_ENABLED=false

# ============================================
# 📋 PHẦN 3: CLOUDFLARE INFRASTRUCTURE
# ============================================

# MOCK - Cloudflare API credentials (for local dev, optional)
# Lấy từ: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=mock_cf_api_token_here
CLOUDFLARE_ACCOUNT_ID=mock_account_id_here

# LOCAL D1 Database
# Production: Auto-configured via binding
# Staging: Sử dụng local SQLite hoặc D1 emulator
D1_DATABASE=apex-os-staging-db

# ============================================
# 📋 PHẦN 4: EMAIL (RESEND)
# ============================================

# MOCK - Resend API key (test mode)
# Đăng ký tại: https://resend.com
RESEND_API_KEY=re_mock_resend_key_for_testing
NEXT_PUBLIC_SENDER_EMAIL=noreply@staging.apex-os.local
NEXT_PUBLIC_SUPPORT_EMAIL=support@staging.apex-os.local

# ============================================
# 📋 PHẦN 5: STELLAR PAYOUTS (USDC)
# ============================================

# MOCK - Stellar testnet credentials
# Testnet wallet: https://testnet.kinzodaily.com hoặc https://xportal.app
# Testnet USDC faucet: https://testnet.stellar.org
STELLAR_SECRET_KEY=mock_stellar_secret_S_56plus_chars_for_testnet_only
STELLAR_NETWORK=testnet
STELLAR_USDC_ISSUER=GA6D2QCM3WQM3YQKV6W5HR5TMRIE5X5QJQZ6WESBG7N5VWBNX6QJX3BM  # Testnet USDC issuer
STELLAR_USDC_CODE=USDC
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org  # Uncomment để override default

# ============================================
# 📋 PHẦN 6: EXCHANGE WEBHOOKS
# ============================================

# MOCK - Webhook secrets for Binance/Bybit
# Production: Lấy từ exchange webhook configuration
BINANCE_WEBHOOK_SECRET=mock_binance_webhook_secret_here
BYBIT_WEBHOOK_SECRET=mock_bybit_webhook_secret_here

# ============================================
# 📋 PHẦN 7: PAYMENT GATEWAYS
# ============================================

# MOCK - Polar (international subscriptions)
# Lấy từ: https://polar.sh
POLAR_ACCESS_TOKEN=mock_polar_access_token_here
POLAR_WEBHOOK_SECRET=mock_polar_webhook_secret_here
POLAR_ORGANIZATION_ID=mock_polar_org_id_here

# MOCK - SePay (Vietnam QR payments)
# Lấy từ: https://sepay.vn
SEPAY_MERCHANT_ID=mock_sepay_merchant_id
SEPAY_SECRET_KEY=mock_sepay_secret_key
SEPAY_API_URL=https://api.sepay.vn

# ============================================
# 📋 PHẦN 8: AI SERVICES
# ============================================

# REAL NEEDED - Anthropic Claude API (for AI features)
# Lấy từ: https://console.anthropic.com
# MOCK below for staging:
ANTHROPIC_API_KEY=mock_anthropic_api_key_sk-ant_mock_for_staging

# MOCK - OpenAI API (optional)
OPENAI_API_KEY=mock_openai_api_key_sk-mock_for_staging

# ============================================
# 📋 PHẦN 9: ADMIN & SECURITY
# ============================================

# MOCK - Admin token for payouts
# Tạo với: openssl rand -base64 32
ADMIN_API_TOKEN=mock_admin_token_for_staging_only

# ============================================
# 📋 PHẦN 10: NOTIFICATION CHANNELS
# ============================================

# Global notification settings
NOTIFICATIONS_ENABLED=true
NOTIFICATION_DEFAULT_PRIORITY=normal
NOTIFICATION_RATE_LIMIT=60
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF=1000
SUPPORT_EMAIL=support@staging.apex-os.local
DOCS_URL=https://docs.apexos-staging.dev

# --------------------------------------------
# Slack Webhook
# --------------------------------------------
# MOCK - Tạo incoming webhook tại: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/mock/mock/mock
SLACK_ENABLED=true
SLACK_CHANNEL=#alerts-staging
SLACK_USERNAME=ApexOS Staging Bot
SLACK_ICON_EMOJI=:rocket:

# --------------------------------------------
# Email Notifications
# --------------------------------------------
NOTIFICATION_EMAIL_RECIPIENTS=admin@staging.apex-os.local,alerts@staging.apex-os.local
RESEND_REPLY_TO=support@staging.apex-os.local

# --------------------------------------------
# Telegram Bot
# --------------------------------------------
# MOCK - Tạo bot qua @BotFather, thêm bot vào chat
TELEGRAM_BOT_TOKEN=mock_telegram_bot_token_123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_IDS=-1001234567890
TELEGRAM_ENABLED=true
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=false

# ============================================
# 📋 PHẦN 11: THIRD-PARTY INTEGRATIONS (NEW)
# ============================================
# Các integrations mới cần thêm vào hệ thống

# --------------------------------------------
# Notion API
# --------------------------------------------
# REAL NEEDED - Lấy từ: https://www.notion.so/my-integrations
# MOCK cho staging:
NOTION_API_TOKEN=mock_notion_integration_token_secret_here
NOTION_DATABASE_ID=mock_notion_database_id_32_chars
NOTION_PAGE_ID=mock_notion_page_id_here

# --------------------------------------------
# Trello API
# --------------------------------------------
# REAL NEEDED - Lấy từ: https://trello.com/app-key
# MOCK cho staging:
TRELLO_API_KEY=mock_trello_api_key_32_chars
TRELLO_API_TOKEN=mock_trello_api_token_here
TRELLO_BOARD_ID=mock_trello_board_id_here
TRELLO_LIST_ID=mock_trello_list_id_here

# --------------------------------------------
# Zalo OA (Official Account)
# --------------------------------------------
# REAL NEEDED - Lấy từ Zalo OA Admin: https://oa.zalo.me
# MOCK cho staging:
ZALO_OA_ID=mock_zalo_oa_id_here
ZALO_OA_SECRET=mock_zalo_oa_secret_key_here
ZALO_ACCESS_TOKEN=mock_zalo_access_token_here
ZALO_REFRESH_TOKEN=mock_zalo_refresh_token_here

# --------------------------------------------
# Google Sheets
# --------------------------------------------
# REAL NEEDED - Service account credentials JSON
# Tạo service account tại: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download JSON credentials file
# MOCK cho staging (Base64 encoded empty JSON):
GOOGLE_SHEETS_CREDENTIALS=mock_google_service_account_credentials_base64_here
GOOGLE_SHEETS_SPREADSHEET_ID=mock_google_sheets_spreadsheet_id_here
GOOGLE_SHEETS_WORKSHEET_NAME=Staging_Data

# --------------------------------------------
# Claude API Key (Alternative access)
# --------------------------------------------
# REAL NEEDED - Lấy từ: https://console.anthropic.com
# Note: ANTHROPIC_API_KEY ở trên là chính, CLAUDE_API_KEY là alias
CLAUDE_API_KEY=mock_claude_api_key_sk-ant_claude_mock_for_staging

# ============================================
# 📋 PHẦN 12: DEVELOPMENT TOOLS
# ============================================

# Debug mode
NEXT_PUBLIC_DEBUG=true
DEBUG=apex-os:*

# Feature flags (staging overrides)
FEATURE_AFFILIATE_PAYOUTS=true
FEATURE_ALERTING=true
FEATURE_MONITORING=true
FEATURE_ANALYTICS=true

# ============================================
# 📋 PHẦN 13: DATABASE (Local Development)
# ============================================

# Local SQLite (alternative to D1 emulator)
# DATABASE_URL=file:./dev.db

# ============================================
# 📋 DOCUMENTATION & REFERENCE
# ============================================

# CREDENTIALS STATUS SUMMARY:
# ============================
# REAL CREDENTIALS (Production only):
# ❌ ANTHROPIC_API_KEY (production)
# ❌ OPENAI_API_KEY (production, optional)
# ❌ RESEND_API_KEY (production)
# ❌ STELLAR_SECRET_KEY (mainnet)
# ❌ BINANCE_WEBHOOK_SECRET / BYBIT_WEBHOOK_SECRET
# ❌ POLAR_ACCESS_TOKEN / POLAR_WEBHOOK_SECRET
# ❌ SEPAY_SECRET_KEY
# ❌ CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID
# ❌ NOTION_API_TOKEN (when integrated)
# ❌ TRELLO_API_KEY + TRELLO_API_TOKEN (when integrated)
# ❌ ZALO_OA_SECRET + ZALO_ACCESS_TOKEN (when integrated)
# ❌ GOOGLE_SHEETS_CREDENTIALS (service account JSON)
#
# MOCK/STAGING CREDENTIALS (This file):
# ✅ ALL values in this .env.staging.example file are MOCK/TEST values
# ✅ Safe to use for development, testing, staging environments
#
# HOW TO GET REAL CREDENTIALS:
# ----------------------------
# 1. Anthropic: https://console.anthropic.com → API Keys
# 2. Resend: https://resend.com → API Keys
# 3. Stellar: Create wallet at https://xportal.app (testnet first)
# 4. Binance/Bybit: Exchange webhook configuration in dashboard
# 5. Polar: https://polar.sh → Organization settings
# 6. SePay: https://sepay.vn → Merchant dashboard
# 7. Notion: https://www.notion.so/my-integrations → New integration
# 8. Trello: https://trello.com/app-key → Get key & token
# 9. Zalo OA: https://oa.zalo.me → Official Account settings
# 10. Google Cloud: Console → IAM → Service Accounts → Create key
#
# SECURITY BEST PRACTICES:
# -----------------------
# 1. NEVER commit .env files (already in .gitignore)
# 2. Use different credentials for staging vs production
# 3. Rotate API keys regularly
# 4. Use read-only keys where possible
# 5. Audit access logs for all integrations
# 6. Store production credentials in secret manager (Cloudflare Secrets, 1Password, etc.)
#
# SETUP CHECKLIST:
# ----------------
# [ ] Copy this file: cp .env.staging.example .env.staging
# [ ] Update BETTER_AUTH_SECRET with: openssl rand -base64 32
# [ ] Update ADMIN_API_TOKEN with: openssl rand -base64 32
# [ ] For production, create .env.local with REAL credentials
# [ ] Verify D1_DATABASE points to correct database
# [ ] Test email sending with RESEND_API_KEY
# [ ] Test Stellar testnet payouts
# [ ] Configure webhook endpoints in Binance/Bybit dashboards
#
